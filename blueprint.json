{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "phpExtensionBundles": [
    "kitchen-sink"
  ],
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installTheme",
      "themeZipFile": {
        "resource": "url",
        "url": "https://github.com/nichewp/lumina/archive/refs/heads/main.zip"
      }
    },
    {
      "step": "activateTheme",
      "themeFolderName": "lumina-main"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Lumina Studio",
        "blogdescription": "Colors, Light, Depth & Motion — Lumina Theme Sandbox"
      }
    },
	{
      "step": "importWxr",
      "file": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/nichewp/lumina/main/assets/demo/lumina-studio.xml"
      }
    },
	{
      "step": "searchAndReplace",
      "search": "https://lumina.nichewp.com",
      "replace": "{SITE_URL}"
    }
  ]
}
